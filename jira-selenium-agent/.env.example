# Jira Configuration
JIRA_SERVER_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@example.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=YOUR_PROJECT
JIRA_ASSIGNEE=currentUser()
JIRA_STORY_TYPE=Story
JIRA_MAX_RESULTS=50

# Selenium Configuration
SELENIUM_BROWSER=chrome
SELENIUM_HEADLESS=true
APP_BASE_URL=http://localhost:8080
SELENIUM_IMPLICIT_WAIT=10
SCREENSHOT_DIR=screenshots

# Output Configuration
FEATURE_OUTPUT_DIR=src/test/resources/features/generated
STEP_DEFINITIONS_DIR=src/test/java/generated/steps
OVERWRITE_FEATURES=false

# LLM Configuration (for auto-updating feature files on commit)
LLM_API_KEY=your-openai-api-key
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.3

# Git Commit Watcher Configuration
GITHUB_TOKEN=your-github-token
GITHUB_REPO=owner/repo-name
WATCHER_POLL_INTERVAL=30
WEBHOOK_PORT=9090

# Copado CI/CD Configuration
COPADO_INSTANCE_URL=https://your-org.my.salesforce.com
COPADO_API_TOKEN=your-copado-session-id-or-oauth-token
COPADO_ORG_ID=your-copado-org-id
COPADO_PIPELINE_ID=your-copado-pipeline-id
COPADO_ENVIRONMENT_ID=your-copado-environment-id
COPADO_CREDENTIAL_ID=your-copado-credential-id
COPADO_API_VERSION=v2
