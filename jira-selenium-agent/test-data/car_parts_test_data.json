{
  "test_suite": "Car Parts Salesforce LWC E2E Automation",
  "application": "Salesforce Lightning - Car Parts Management",
  "framework": "Lightning Web Components (LWC)",

  "relationship_model": {
    "description": "Salesforce multi-relationship data model with Lookup and Master-Detail fields",
    "api_identity_rules": {
      "__c_suffix": "Stores the Record ID (foreign key) - e.g. Manufacturer__c = 'MFR-001'",
      "__r_suffix": "Resolves to the full parent/child object - e.g. Manufacturer__r.Name = 'BorgWarner'"
    },
    "objects": {
      "Car_Part__c": {
        "api_name": "Car_Part__c",
        "label": "Car Part",
        "key_prefix": "CP",
        "description": "Central data hub connected to multiple objects via relationships",
        "parent_relationships": [
          {"field_api_name": "Manufacturer__c", "relationship_name": "Manufacturer__r", "type": "Lookup", "related_to": "Manufacturer__c"},
          {"field_api_name": "Warehouse__c", "relationship_name": "Warehouse__r", "type": "Lookup", "related_to": "Warehouse__c"}
        ],
        "child_relationships": [
          {"relationship_name": "Orders__r", "child_object": "Order__c", "field": "Car_Part__c", "type": "Master-Detail"},
          {"relationship_name": "Warranty_Claims__r", "child_object": "Warranty_Claim__c", "field": "Car_Part__c", "type": "Lookup"}
        ]
      },
      "Manufacturer__c": {
        "api_name": "Manufacturer__c",
        "label": "Manufacturer",
        "key_prefix": "MFR",
        "parent_relationships": [
          {"field_api_name": "Primary_Supplier__c", "relationship_name": "Primary_Supplier__r", "type": "Lookup", "related_to": "Supplier__c"}
        ],
        "child_relationships": [
          {"relationship_name": "Car_Parts__r", "child_object": "Car_Part__c", "field": "Manufacturer__c", "type": "Lookup"}
        ]
      },
      "Warehouse__c": {
        "api_name": "Warehouse__c",
        "label": "Warehouse",
        "key_prefix": "WH",
        "parent_relationships": [],
        "child_relationships": [
          {"relationship_name": "Car_Parts__r", "child_object": "Car_Part__c", "field": "Warehouse__c", "type": "Lookup"},
          {"relationship_name": "Orders__r", "child_object": "Order__c", "field": "Ship_From_Warehouse__c", "type": "Lookup"}
        ]
      },
      "Supplier__c": {
        "api_name": "Supplier__c",
        "label": "Supplier",
        "key_prefix": "SUP",
        "parent_relationships": [],
        "child_relationships": [
          {"relationship_name": "Manufacturers__r", "child_object": "Manufacturer__c", "field": "Primary_Supplier__c", "type": "Lookup"}
        ]
      },
      "Order__c": {
        "api_name": "Order__c",
        "label": "Order",
        "key_prefix": "ORD",
        "parent_relationships": [
          {"field_api_name": "Car_Part__c", "relationship_name": "Car_Part__r", "type": "Master-Detail", "related_to": "Car_Part__c"},
          {"field_api_name": "Ship_From_Warehouse__c", "relationship_name": "Ship_From_Warehouse__r", "type": "Lookup", "related_to": "Warehouse__c"}
        ],
        "child_relationships": [
          {"relationship_name": "Warranty_Claims__r", "child_object": "Warranty_Claim__c", "field": "Order__c", "type": "Lookup"}
        ]
      },
      "Warranty_Claim__c": {
        "api_name": "Warranty_Claim__c",
        "label": "Warranty Claim",
        "key_prefix": "WC",
        "parent_relationships": [
          {"field_api_name": "Car_Part__c", "relationship_name": "Car_Part__r", "type": "Lookup", "related_to": "Car_Part__c"},
          {"field_api_name": "Order__c", "relationship_name": "Order__r", "type": "Lookup", "related_to": "Order__c"}
        ],
        "child_relationships": []
      }
    }
  },

